# CS Nexus (csmju-nexus) — Backend
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง · ห้าม commit .env

# ---- Database (Database-per-Subsystem · Blueprint หน้า 10) ----
# dev: docker run -d --name csnexus-pg -e POSTGRES_PASSWORD=postgres \
#        -e POSTGRES_DB=csnexus_social_reels -p 55432:5432 postgres:17-alpine
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/csnexus_social_reels

PORT=4222
NODE_ENV=development
TZ=Asia/Bangkok

# ฐานข้อมูลบน server ใช้ร่วมกันหลายระบบ — จำกัด connection ของระบบนี้ (deployment.md ข้อ 4.1 · server ตั้ง 5)
DATABASE_POOL_MAX=5

# ---- ไฟล์ของผู้ใช้ (รูป คลิป ไฟล์แนบ เสียง) ----
# เก็บในฐานข้อมูลของระบบ (ตาราง stored_objects) ไฟล์ละไม่เกิน 10 MB — standards deployment.md ข้อ 4.3
# ลิงก์อัปโหลด/ดาวน์โหลดเป็น path บนโดเมนของหน้าเว็บ (/api/v1/asset-blobs/...) ลงนามด้วยกุญแจนี้
# ไม่ตั้ง = สุ่มใหม่ทุกครั้งที่ api เริ่ม (ลิงก์ที่แจกไปแล้วใช้ไม่ได้หลังรีสตาร์ต) · สร้างด้วย: openssl rand -hex 32
STORAGE_URL_SECRET=

# ใช้กับสคริปต์ย้ายไฟล์รุ่นเก่าจากดิสก์เข้าฐานเท่านั้น (pnpm --filter backend assets:import-disk) — server ไม่ต้องตั้ง
LOCAL_STORAGE_DIR=./storage-dev

# ---- WebRTC (ห้องเสียง + แชร์หน้าจอ) ----
#
# STUN ใช้ฟรี ไม่ต้องตั้งอะไร — ระบบใส่ของ Google กับ Cloudflare ไว้ให้แล้ว
# สี่ตัว (ดู voice.service.ts) ครอบคลุมผู้ใช้ส่วนใหญ่
#
# TURN จำเป็นเฉพาะกับคนที่อยู่หลัง NAT แบบเจาะไม่ได้ หรือเน็ตที่บล็อก UDP
# ขาออก — พบบ่อยในเน็ตมหาลัยและหอพัก ถ้าไม่มี คนกลุ่มนั้นจะโทรไม่ติดเลย
#
# **ให้ผู้ใช้กดปุ่ม "ตรวจว่าเครือข่ายนี้โทรได้ไหม" ในหน้าห้องเสียงก่อน**
# ถ้าผลออกมาว่าโทรได้ ก็ยังไม่ต้องตั้ง TURN
#
# ตั้ง TURN แบบไม่เสียเงิน เลือกทางใดทางหนึ่ง:
#
#   1. รัน coturn เองบนเครื่องที่มีอยู่แล้ว (เครื่องแล็บ เซิร์ฟเวอร์คณะ
#      หรือแม้แต่โน้ตบุ๊กตอนเดโม) — ฟรีสนิท ข้อแลกคือเครื่องต้องเปิดค้าง
#      และต้องเปิดพอร์ตให้เข้าถึงได้จากเน็ตที่ผู้ใช้อยู่
#        docker run -d --network host coturn/coturn \
#          -n --realm=cs-nexus --user=csnexus:เปลี่ยนรหัสนี้ \
#          --listening-port=3478 --fingerprint --lt-cred-mech
#      แล้วตั้ง TURN_URL=turn:<ไอพีเครื่องนั้น>:3478
#
#   2. ผู้ให้บริการที่มีชั้นใช้ฟรี (ต้องสมัครบัญชี แต่ไม่ต้องผูกบัตรก็มี)
#      — วางค่าที่เขาให้มาลงสามบรรทัดข้างล่างได้เลย
#
#   3. VPS ชั้นฟรีถาวร แล้วลง coturn ตามข้อ 1
#
# เรื่องความเป็นส่วนตัวที่ควรรู้: เสียงที่วิ่งผ่าน TURN ยังถูกเข้ารหัสแบบ
# ปลายทางถึงปลายทางด้วย DTLS-SRTP เจ้าของ TURN จึงเห็นแค่ว่ามีทราฟฟิกวิ่งผ่าน
# **ฟังเนื้อเสียงไม่ได้** การใช้ TURN ของคนอื่นจึงยอมรับได้ในแง่ความลับ
#
# ใส่หลาย URL ได้ คั่นด้วยลูกน้ำ (เช่น ใส่ทั้ง UDP และ TCP/443 เผื่อโดนบล็อก)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- CORS ----
# โดเมนของหน้าบ้าน คั่นด้วยลูกน้ำ เว้นว่างในโหมด dev
CORS_ORIGIN=

# ─────────────────────────────────────────────────────────────────────
# Core Hub — standards 1.7.0 (auth-contract.md ข้อ 2 · connect-core-hub.md ข้อ 4)
#
# CORE_HUB_URL ถึง SUBSYSTEM_ID คือ requiredEnvVars ตาม contracts/vocabulary.json
# ค่าที่ตรึงไว้ (ISSUER / AUDIENCE) **ห้ามเปลี่ยนเอง** เป็นส่วนหนึ่งของสัญญา
#
# server จริง: ทั้ง CORE_HUB_URL และ CORE_HUB_WEB_URL เป็น https://csmju2030.jowave.com
# และ CORE_HUB_JWKS_URL เป็น https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
# ─────────────────────────────────────────────────────────────────────
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
SUBSYSTEM_ID=csmju-nexus

# เว็บของ Core Hub (ไม่ใช่ API) — GET /auth/login ส่งเบราว์เซอร์ไปที่
# <ค่านี้>/sso/authorize และ POST /auth/logout พาไป <ค่านี้>/logout
# ใช้ Core Hub ตัวจริงเสมอ (ไม่ต้องรัน Core Hub เอง) · ไม่ตั้ง = ใช้ค่าเดียวกับ CORE_HUB_URL
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# ไม่ต้องตั้ง FRONTEND_URL แล้ว — หน้าบ้าน (:3222) rewrite /auth/* มาที่นี่
# callback จึง redirect ด้วย path ภายใน (เช่น /feed) บน origin ของหน้าบ้านเอง

# ─── พอร์ตที่ใช้กันในเครื่องพัฒนา ────────────────────────────────────
#
#   3000  Core Hub API   ·  3100  Core Hub UI
#   4222  หลังบ้านเรา     ·  3222  หน้าบ้านเรา
#  55432  PostgreSQL (คนละ database: core_hub / csnexus_social_reels)

# การแคชกุญแจ JWKS (auth-contract.md ข้อ 4.1)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000

# เหลื่อมนาฬิกาได้ไม่เกิน 60 วินาทีตามสัญญา — ค่าแนะนำคือ 5
JWT_CLOCK_TOLERANCE_SEC=5

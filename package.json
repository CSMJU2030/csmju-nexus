{
  "name": "csmju-nexus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "check:standards": "bash standards/scripts/run-all-checks.sh .",
    "conformance": "node standards/conformance/run.js",
    "setup": "git config core.hooksPath .githooks && echo เปิดใช้ git hooks แล้ว"
  }
}

# ─────────────────────────────────────────────────────────────────────
# หน้าบ้าน — ตัวอย่างค่า environment
#
# คัดลอกเป็น .env.local แล้วแก้ค่าให้ตรงเครื่องตัวเอง (.env.local ถูก gitignore)
#
# **ทุกค่าที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลงไฟล์ JavaScript ที่ส่งให้เบราว์เซอร์**
# ใครก็เปิดดูได้ ห้ามใส่ความลับใด ๆ ตรงนี้เด็ดขาด (ui-design-system.md ข้อ 16.1.1)
# ─────────────────────────────────────────────────────────────────────

# ─── หน้าบ้านเป็นประตูเดียวของระบบ (standards 1.7.0 · connect-core-hub.md ข้อ 1) ───
#
# next.config.ts rewrite /api/* และ /auth/login /auth/callback /auth/logout ไปที่ค่านี้
# ไม่ใช่ NEXT_PUBLIC_ — เบราว์เซอร์ไม่ต้องรู้ว่าหลังบ้านอยู่ที่ไหน (เรียก /api/v1 บน origin เดียวกัน)
# build สำหรับ Docker ต้องตั้งค่านี้ตอน `next build` ด้วย เพราะ rewrite ถูกคำนวณตอน build
BACKEND_URL=http://127.0.0.1:4222

# socket.io ต่อผ่าน rewrite /realtime ของหน้าเว็บ (โดเมนเดียวกัน) — ไม่ต้องตั้งค่า

# เว็บของ Core Hub — ใช้ทำลิงก์ไปหน้าบัญชี/โปรไฟล์ที่ Core Hub เท่านั้น
# **ไม่ใช่ทางเข้าระบบ** ทางเข้าคือ /auth/login ของเราเอง (auth-contract.md ข้อ 5)
# server จริง: https://csmju2030.jowave.com
NEXT_PUBLIC_CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# ชื่อเดิมของ SSO 1.0 (launcher /api/sso/<ชื่อ>) — ไม่ได้ใช้เข้าระบบแล้ว
# ยังมีหน้าตั้งค่าโปรไฟล์อ่านแค่ origin ของค่านี้ จนกว่าจะย้ายไปใช้ NEXT_PUBLIC_CORE_HUB_WEB_URL
NEXT_PUBLIC_CORE_LOGIN_URL=

# Core Hub ยังไม่มีหน้าสมัครสมาชิกแยก (บัญชีมาจากทะเบียนของมหาวิทยาลัย)
# ปล่อยว่างไว้ ปุ่ม "สมัคร" จะถูกปิดพร้อมคำอธิบาย แทนที่จะพาไปหน้าตาย
NEXT_PUBLIC_CORE_SIGNUP_URL=

# ─── พอร์ตที่ใช้กันในเครื่องพัฒนา ────────────────────────────────────
#
#   3000  Core Hub API        (csmju-core-hub/backend — ตรึงไว้ในโค้ดเขา)
#   3100  Core Hub UI         (csmju-core-hub/frontend)
#   4222  หลังบ้านของเรา
#   3222  หน้าบ้านของเรา        ← ต้องไม่ใช่ 3000 ไม่งั้นชนกับ Core Hub API
#  55432  PostgreSQL

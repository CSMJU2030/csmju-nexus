# ---------------------------------------------------------------------------
# csmju-nexus — ไฟล์ environment จริงแยกตามฝั่ง (ไฟล์นี้ไม่ได้ถูกอ่าน)
#
#   backend/.env.example        → คัดลอกเป็น backend/.env
#   frontend/.env.example       → คัดลอกเป็น frontend/.env.local
#
# ห้าม commit .env / .env.local · ค่าสำคัญที่ต้องตรงกันทั้งสองฝั่ง:
# ---------------------------------------------------------------------------

# พอร์ตที่ผู้ดูแล dev server กำหนดให้ csmju-nexus (frontend 3222 · backend 4222)
# callback ที่ลงทะเบียนกับ Core Hub = http://localhost:3222/auth/callback
SUBSYSTEM_ID=csmju-nexus

# Core Hub ตัวจริงของโครงการ (อ่านจาก env เสมอ — ห้ามเขียนตายในโค้ด)
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json

# สัญญาที่ตรึงไว้ — ห้ามเปลี่ยน
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
